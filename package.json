{
  "name": "die-ordering-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test \"server/**/*.test.cjs\"",
    "server": "node server/index.cjs",
    "server:dev": "node --watch server/index.cjs",
    "build": "vite build",
    "build:check": "npm run lint && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "docker:rebuild": "docker compose build --no-cache && docker compose up -d",
    "db:backup": "docker exec die-ordering-db pg_dump -U postgres die_ordering | gzip > backup-$(date +%Y%m%d-%H%M%S).sql.gz"
  },
  "dependencies": {
    "@lmstudio/sdk": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "imapflow": "^1.3.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.561.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.5",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.449",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pdf-parse": "^2.4.5",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}

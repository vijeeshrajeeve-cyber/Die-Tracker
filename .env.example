# ===========================================
# Die Ordering App - Production Configuration
# ===========================================

# Environment
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# ===========================================
# JWT Configuration (REQUIRED - CHANGE THIS!)
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_64_CHARACTER_OR_LONGER_RANDOM_STRING
JWT_EXPIRES_IN=24h

# ===========================================
# PostgreSQL Database (REQUIRED)
# ===========================================
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=die_ordering

# For Docker deployment (uses container name)
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@supabase-db:5432/die_ordering

# For local development (uncomment if not using Docker)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=die_ordering
# PGUSER=postgres
# PGPASSWORD=your_password

# ===========================================
# Default Admin Account
# ===========================================
# Only used for initial setup - CHANGE PASSWORD AFTER FIRST LOGIN!
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# =============================================================================
# Die Ordering App — Production Environment
# Copy to .env and fill in the required values.
# =============================================================================
# Quick commands to generate secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — must be set before first boot
# -----------------------------------------------------------------------------

# PostgreSQL superuser password (used by the db container AND backend).
# NOTE: this is only applied when the postgres_data volume is FIRST created.
# Changing it later does not update an existing database on its own — you must
# also run: ALTER USER postgres WITH PASSWORD '<new value>' (see README/backend
# startup message for the exact command).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# JWT signing secret (64+ hex chars). Rotating this invalidates all sessions.
JWT_SECRET=CHANGE_ME_RUN_THE_NODE_CRYPTO_COMMAND_ABOVE

# Initial admin account, created on first database initialization ONLY.
# Change the password via the UI immediately after first login; changing it
# here later has no effect.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# Standard defaults — only change if you know why
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

POSTGRES_DB=die_ordering
POSTGRES_USER=postgres

# NOTE: The backend's PG* connection vars are derived from the POSTGRES_*
# values above and injected by docker-compose.yml. Do not duplicate them here.

# Session lifetime for issued JWTs.
JWT_EXPIRES_IN=24h

# Rate limits. Defaults are generous for a small team on a LAN.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=5

# Comma-separated list of allowed origins for browser CORS.
# Leave empty when frontend and backend share an origin (the default Nginx setup).
# Example for a multi-host deployment: ALLOWED_ORIGINS=http://dies.lan,http://10.0.0.5:8080
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Optional — Power Automate / email integration
# Leave EMAIL_ENABLED=false if you are not using this feature.
# -----------------------------------------------------------------------------
EMAIL_ENABLED=false
PA_SEND_FLOW_URL=
PA_WEBHOOK_SECRET=
PA_MAILBOX_EMAIL=

# -----------------------------------------------------------------------------
# Port mapping exposed to the host (see docker-compose.yml)
#   Frontend (Nginx): 8080 -> 80    ← only this is reachable from the LAN
#   Backend API:      internal only
#   PostgreSQL:       internal only
# To change the frontend port, set FRONTEND_PORT below.
# -----------------------------------------------------------------------------
FRONTEND_PORT=8080

# Dependencies
node_modules/
npm-debug.log*

# Build outputs
dist/
build/

# Git / tooling
.git/
.gitignore
.github/
.vscode/
.idea/
.claude/
.dockerignore
eslint.config.js

# Docs (README copied separately if needed)
*.md
!README.md
docs/
TestData/

# Environment files — NEVER bake secrets into images.
# Values must come from docker-compose at runtime.
.env
.env.*
!.env.example

# Database files
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db
*Zone.Identifier

# Backup / temp files
*.backup
*.bak
*.log

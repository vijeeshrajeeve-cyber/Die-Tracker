FROM node:20-alpine

# wget is used by the docker-compose healthcheck.
RUN apk add --no-cache wget tini

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY server/ ./server/

# Create the backups and frozen-designs directories inside the image so Docker
# initialises the named volumes with the correct node ownership on first use.
RUN mkdir -p /app/backups /app/storage/frozen-designs && chown -R node:node /app
USER node

EXPOSE 3001

# tini handles PID 1 signals correctly (clean SIGTERM on `docker compose down`).
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server/index.cjs"]
